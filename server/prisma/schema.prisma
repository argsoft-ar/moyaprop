// Prisma schema para MoyaProp
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OperationType {
  VENTA
  ALQUILER
}

enum PropertyType {
  CASA
  DEPARTAMENTO
  PH
  TERRENO
  LOCAL
  OFICINA
  QUINTA
  GALPON
  OTRO
}

enum Currency {
  USD
  ARS
}

enum PropertyStatus {
  ACTIVA
  PAUSADA
  VENDIDA
  ALQUILADA
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

model Property {
  id            String         @id @default(uuid())
  title         String
  description   String         @db.Text
  operationType OperationType
  propertyType  PropertyType
  price         Decimal        @db.Decimal(12, 2)
  currency      Currency       @default(USD)
  expenses      Decimal?       @db.Decimal(10, 2)
  
  // Características físicas
  totalArea     Decimal        @db.Decimal(8, 2)
  coveredArea   Decimal        @db.Decimal(8, 2)
  bedrooms      Int            @default(0)
  bathrooms     Int            @default(0)
  garages       Int            @default(0)

  // Ubicación
  address       String
  city          String
  neighborhood  String?

  // Estado y visibilidad
  status        PropertyStatus @default(ACTIVA)
  featured      Boolean        @default(false)

  // Multimedia
  images        PropertyImage[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, operationType, propertyType])
  @@index([city])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(uuid())
  url        String
  publicId   String   // Cloudinary public ID para borrado seguro
  order      Int      @default(0)
  isCover    Boolean  @default(false)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([propertyId, order])
  @@map("property_images")
}
