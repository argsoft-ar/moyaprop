# Puerto del servidor
PORT=4000

# Entorno (development | production)
NODE_ENV=development

# Base de datos PostgreSQL (ej. Supabase, Neon o Render)
DATABASE_URL="postgresql://usuario:password@host:5432/moyaprop?schema=public"

# Clave secreta para generación de tokens JWT (usa un string largo y aleatorio)
JWT_SECRET="moyaprop_super_secret_jwt_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Configuración de Cloudinary para almacenamiento multimedia
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# URL del frontend permitida en CORS
CLIENT_URL="http://localhost:5173"
